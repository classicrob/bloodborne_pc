#version 450
// Serial integer work per invocation: GPU time grows linearly with `iterations`.
layout(local_size_x = 64) in;
layout(push_constant) uniform Params { uint iterations; } params;
layout(std430, binding = 0) buffer Output { uint data[]; } result;
void main() {
    uint x = gl_GlobalInvocationID.x + 1u;
    for (uint i = 0u; i < params.iterations; ++i) {
        x ^= x << 13u; x ^= x >> 17u; x ^= x << 5u;
    }
    result.data[gl_GlobalInvocationID.x] = x;
}
