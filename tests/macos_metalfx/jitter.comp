#version 450
layout(local_size_x=8, local_size_y=8) in;
layout(binding=0, rgba16f) uniform writeonly image2D color;
layout(push_constant) uniform Params { vec2 viewport_jitter; vec2 translation; } params;
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel,imageSize(color)))) return;
    vec2 sample_position = vec2(pixel)+0.5-params.viewport_jitter-params.translation;
    imageStore(color,pixel,vec4(0.5+0.25*sin(sample_position*0.3926990817),0.25,0.75));
}
