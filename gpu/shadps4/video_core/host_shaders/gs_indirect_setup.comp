// bbport (Apple): geometry-stage emulation of an indirect ES/GS draw (vk_gs_emulation.cpp).
// Reads the guest's VkDraw[Indexed]IndirectCommand and writes, into the draw's scratch, the header
// the ES/GS compute roles read (shader_recompiler/gs_emulation.h) and the indirect commands of the
// ES dispatch, the GS dispatch and the strip draw. A draw that needs more scratch than the range
// holds, or more indices than the bound index buffer, draws nothing and is reported in `errors`
// (the renderer stops loudly when it sees a report).
#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require

layout(local_size_x = 1) in;

layout(std430, binding = 0) readonly buffer Args { uint args[]; };
layout(std430, binding = 1) buffer Scratch { uint scratch[]; };
layout(std430, binding = 2) buffer Errors { uint errors[]; };

layout(push_constant) uniform Params {
    uint args_skip;       // dwords before the command in the bound args range
    uint indexed;         // 1: VkDrawIndexedIndirectCommand
    uint index_kind;      // gs_emulation.h IndexKind of an indexed draw
    uint index_skip;      // index elements before the guest index buffer in its bound range
    uint index_count;     // indices in the guest index buffer (INDEX_BUFFER_SIZE)
    uint verts_per_prim;
    uint invocations;
    uint max_vert_out;
    uint esgs_dwords;
    uint vertex_dwords;
    uint run_length;
    uint capacity_dwords; // dwords of the scratch range
};

// Header (gs_emulation.h)
const uint RecordsPerInstance = 0, PrimsPerInstance = 1, Instances = 2, IndexKindField = 3,
           BaseVertex = 4, BaseInstance = 5, FirstIndex = 6, EsgsBase = 7, GsvsBase = 8,
           IndexBase = 9, EsDispatch = 16, GsDispatch = 19, StripDraw = 22, IndirectDwords = 32;
// errors[]: [0] reports, [1] largest scratch dwords asked for, [2] index overruns
const uint WorkgroupSize = 64;

void main() {
    uint count = args[args_skip + 0];
    uint instances = args[args_skip + 1];
    uint first_index = 0;
    uint base_vertex, base_instance;
    if (indexed != 0) {
        first_index = args[args_skip + 2];
        base_vertex = args[args_skip + 3]; // vertexOffset (int32 bits)
        base_instance = args[args_skip + 4];
        if (uint64_t(first_index) + count > index_count) {
            atomicAdd(errors[0], 1);
            atomicAdd(errors[2], 1);
            count = 0;
        }
    } else {
        base_vertex = args[args_skip + 2];
        base_instance = args[args_skip + 3];
    }
    uint prims = count / verts_per_prim;
    uint64_t slots = uint64_t(prims) * instances * invocations;
    uint64_t esgs = uint64_t(count) * instances * esgs_dwords;
    uint64_t gsvs = slots * max_vert_out * vertex_dwords;
    uint64_t needed = IndirectDwords + esgs + gsvs + slots * run_length;
    if (needed > capacity_dwords) {
        atomicAdd(errors[0], 1);
        atomicMax(errors[1], needed > 0xFFFFFFFFul ? 0xFFFFFFFFu : uint(needed));
        count = 0;
        prims = 0;
        slots = 0;
        esgs = 0;
        gsvs = 0;
    }
    const uint esgs_base = IndirectDwords;
    const uint gsvs_base = esgs_base + uint(esgs);
    const uint index_base = gsvs_base + uint(gsvs);
    scratch[RecordsPerInstance] = count;
    scratch[PrimsPerInstance] = prims;
    scratch[Instances] = instances;
    scratch[IndexKindField] = indexed != 0 ? index_kind : 0;
    scratch[BaseVertex] = base_vertex;
    scratch[BaseInstance] = base_instance;
    scratch[FirstIndex] = index_skip + first_index;
    scratch[EsgsBase] = esgs_base;
    scratch[GsvsBase] = gsvs_base;
    scratch[IndexBase] = index_base;
    scratch[EsDispatch + 0] = (count + WorkgroupSize - 1) / WorkgroupSize;
    scratch[EsDispatch + 1] = count != 0 ? instances : 0;
    scratch[EsDispatch + 2] = 1;
    scratch[GsDispatch + 0] = (prims + WorkgroupSize - 1) / WorkgroupSize;
    scratch[GsDispatch + 1] = prims != 0 ? instances * invocations : 0;
    scratch[GsDispatch + 2] = 1;
    scratch[StripDraw + 0] = uint(slots) * run_length;
    scratch[StripDraw + 1] = 1;
    scratch[StripDraw + 2] = index_base;
    scratch[StripDraw + 3] = 0;
    scratch[StripDraw + 4] = 0;
}
